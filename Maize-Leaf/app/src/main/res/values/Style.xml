<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="OtpInputStyle">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">54dp</item>
        <item name="android:background">@drawable/otp_box_bg</item>
        <item name="android:gravity">center</item>
        <item name="android:inputType">numberDecimal</item>
        <item name="android:maxLength">1</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#111827</item>
        <item name="android:cursorVisible">false</item>
<!--        <item name="android:importantForAutofill">no</item>-->
    </style>
    <style name="RoundedDialogShape" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

    <style name="RoundedDialogTheme" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/RoundedDialogShape</item>
        <item name="buttonBarPositiveButtonStyle">@style/RoundedDialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/RoundedDialogButton</item>
    </style>

    <style name="RoundedDialogButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>