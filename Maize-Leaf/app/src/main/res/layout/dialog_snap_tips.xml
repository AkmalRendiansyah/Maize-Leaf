<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp"
    android:background="@drawable/bg_dialog_rounded">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tips_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tips Mengambil Gambar"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_gravity="center"
            android:layout_marginBottom="16dp" />

        <!-- Grid 2x2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- 1. Terlalu banyak daun -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:id="@+id/image_tip_many"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/snap1"
                    android:contentDescription="tip_many_leaves" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginTop="4dp"
                    android:src="@drawable/baseline_close_24"
                    android:contentDescription="wrong" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Jangan terlalu banyak daun dalam 1 foto"
                    android:textSize="12sp"
                    android:textAlignment="center"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- 2. Blur -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:id="@+id/image_tip_blur"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/snap2"
                    android:contentDescription="tip_blur_leaf" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginTop="4dp"
                    android:src="@drawable/baseline_close_24"
                    android:contentDescription="wrong" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Jangan ambil gambar yang blur"
                    android:textSize="12sp"
                    android:textAlignment="center"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <!-- 3. Bukan daun jagung -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:id="@+id/image_tip_non_leaf"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/snap3"
                    android:contentDescription="tip_non_corn_leaf" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginTop="4dp"
                    android:src="@drawable/baseline_close_24"

                    android:contentDescription="wrong" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Jangan ambil objek selain daun jagung"
                    android:textSize="12sp"
                    android:textAlignment="center"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- 4. Benar -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:id="@+id/image_tip_correct"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/snap4"
                    android:contentDescription="tip_correct_leaf" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginTop="4dp"
                    android:src="@drawable/baseline_check_24"
                    android:contentDescription="correct" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ambil 1 daun jagung dengan jelas"
                    android:textSize="12sp"
                    android:textAlignment="center"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/dialog_tips_close_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Mengerti" />

    </LinearLayout>
</ScrollView>